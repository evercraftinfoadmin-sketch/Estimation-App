        }
       },
       {
        "user_condition": {
         "data.crm_role": "admin"
        }
       }
      ]
     }
    }
   }
  },
  "required": [
   "legacy_id",
   "costId",
   "decision"
  ],
  "rls": {
   "read": {
    "$or": [
     {
      "user_condition": {
       "data.crm_role": "owner"
      }
     },
     {
      "user_condition": {
       "data.crm_role": "admin"
      }
     },
     {
      "user_condition": {
       "data.crm_role": "member"
      }
     }
    ]
   },
   "create": {
    "$or": [
     {
      "user_condition": {
       "data.crm_role": "owner"
      }
     },
     {
      "user_condition": {
       "data.crm_role": "admin"
      }
     }
    ]
   },
   "update": {
    "user_condition": {
     "data.crm_role": "owner"
    }
   },
   "delete": {
    "user_condition": {
     "data.crm_role": "owner"
    }
   }
  }
 },
