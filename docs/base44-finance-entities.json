 {
  "name": "CostEntry",
  "type": "object",
  "description": "Project cost ledger: material, labor or expense. Amounts in cents. Never deleted: voided with a reason. Approval is a separate CostApproval record.",
  "properties": {
   "projectId": {
    "type": "string",
    "description": "CrmProject.legacy_id ('' = company-wide)"
   },
   "type": {
    "type": "string",
    "enum": [
     "material",
     "labor",
     "expense"
    ]
   },
   "category": {
    "type": "string"
   },
   "classification": {
    "type": "string",
    "enum": [
     "direct",
     "overhead",
     "allocated"
    ],
    "default": "direct"
   },
   "description": {
    "type": "string"
   },
   "vendor": {
    "type": "string"
   },
   "date": {
    "type": "string"
   },
   "quantity": {
    "type": "number"
   },
   "unit": {
    "type": "string"
   },
   "unitOther": {
    "type": "string"
   },
   "estUnitCents": {
    "type": "integer"
   },
   "actUnitCents": {
    "type": "integer"
   },
   "employeeId": {
    "type": "string"
   },
   "costMethod": {
    "type": "string",
    "enum": [
     "hourly",
     "fixed",
     "subcontract"
    ],
    "default": "hourly"
   },
   "startTime": {
    "type": "string"
   },
   "endTime": {
    "type": "string"
   },
   "breakMinutes": {
    "type": "integer"
   },
   "hours": {
    "type": "number"
   },
   "workCategory": {
    "type": "string"
   },
   "amountCents": {
    "type": "integer"
   },
   "status": {
    "type": "string",
    "enum": [
     "active",
     "void"
    ],
    "default": "active"
   },
   "voidReason": {
    "type": "string"
   },
   "receiptPhotoId": {
    "type": "string"
   },
   "notes": {
    "type": "string"
   },
   "createdBy": {
    "type": "string"
   },
   "createdAt": {
    "type": "string"
   },
   "updatedAt": {
    "type": "string"
   },
   "legacy_id": {
    "type": "string",
    "description": "App id (unique)"
   },
   "version": {
    "type": "integer",
    "default": 1
   },
   "extra": {
    "type": "object",
    "additionalProperties": true
   },
   "deletedAt": {
    "type": "string",
    "description": "Soft delete timestamp (ISO). Admins only.",
    "rls": {
     "write": {
      "$or": [
       {
        "user_condition": {
         "data.crm_role": "owner"
        }
       },
       {
        "user_condition": {
         "data.crm_role": "admin"
        }
       }
      ]
     }
    }
   }
  },
  "required": [
   "legacy_id",
   "projectId",
   "type",
   "date"
  ],
  "rls": {
   "read": {
    "$or": [
     {
      "user_condition": {
       "data.crm_role": "owner"
      }
     },
     {
      "user_condition": {
       "data.crm_role": "admin"
      }
     },
     {
      "user_condition": {
       "data.crm_role": "member"
      }
     }
    ]
   },
   "create": {
    "$or": [
     {
      "user_condition": {
       "data.crm_role": "owner"
      }
     },
     {
      "user_condition": {
       "data.crm_role": "admin"
      }
     },
     {
      "user_condition": {
       "data.crm_role": "member"
      }
     }
    ]
   },
   "update": {
    "$or": [
     {
      "user_condition": {
       "data.crm_role": "owner"
      }
     },
     {
      "user_condition": {
       "data.crm_role": "admin"
      }
     },
     {
      "$and": [
       {
        "user_condition": {
         "data.crm_role": "member"
        }
       },
       {
        "created_by_id": "{{user.id}}"
       }
      ]
     }
    ]
   },
   "delete": {
    "user_condition": {
     "data.crm_role": "owner"
    }
   }
  }
 },
 {
