[
 {
  "name": "Employee",
  "type": "object",
  "description": "People who work on jobs (also without a CRM login). No pay rates here: see EmployeeRate.",
  "properties": {
   "name": {
    "type": "string"
   },
   "payType": {
    "type": "string",
    "enum": [
     "hourly",
     "salary",
     "fixed",
     "subcontractor"
    ],
    "default": "hourly"
   },
   "userEmail": {
    "type": "string",
    "description": "CRM login email (optional)"
   },
   "active": {
    "type": "boolean",
    "default": true
   },
   "createdAt": {
    "type": "string"
   },
   "updatedAt": {
    "type": "string"
   },
   "legacy_id": {
    "type": "string",
    "description": "App id (unique)"
   },
   "version": {
    "type": "integer",
    "default": 1
   },
   "extra": {
    "type": "object",
    "additionalProperties": true
   },
   "deletedAt": {
    "type": "string",
    "description": "Soft delete timestamp (ISO). Admins only.",
    "rls": {
     "write": {
      "$or": [
       {
        "user_condition": {
         "data.crm_role": "owner"
        }
       },
       {
        "user_condition": {
         "data.crm_role": "admin"
        }
       }
      ]
     }
    }
   }
  },
  "required": [
   "legacy_id",
   "name"
  ],
  "rls": {
   "read": {
    "$or": [
     {
      "user_condition": {
       "data.crm_role": "owner"
      }
     },
     {
      "user_condition": {
       "data.crm_role": "admin"
      }
     },
     {
      "user_condition": {
       "data.crm_role": "member"
      }
     }
    ]
   },
   "create": {
    "$or": [
     {
      "user_condition": {
       "data.crm_role": "owner"
      }
     },
     {
      "user_condition": {
       "data.crm_role": "admin"
      }
     }
    ]
   },
   "update": {
    "$or": [
     {
      "user_condition": {
       "data.crm_role": "owner"
      }
     },
     {
      "user_condition": {
       "data.crm_role": "admin"
      }
     }
    ]
   },
   "delete": {
    "user_condition": {
     "data.crm_role": "owner"
    }
   }
  }
 },
 {
  "name": "EmployeeRate",
  "type": "object",
  "description": "Labor COST rate of an employee from a date (cents per hour) and optional burden %. Owners/admins only. New rates are new rows; old ones are kept.",
  "properties": {
   "employeeId": {
    "type": "string",
    "description": "Employee.legacy_id"
   },
   "rateCents": {
    "type": "integer"
   },
   "burdenPercent": {
    "type": "number",
    "default": 0
   },
   "effectiveFrom": {
    "type": "string",
    "description": "YYYY-MM-DD"
   },
   "createdBy": {
    "type": "string"
   },
   "createdAt": {
    "type": "string"
   },
   "legacy_id": {
    "type": "string",
    "description": "App id (unique)"
   },
   "version": {
    "type": "integer",
    "default": 1
   },
   "extra": {
    "type": "object",
    "additionalProperties": true
   },
   "deletedAt": {
    "type": "string",
    "description": "Soft delete timestamp (ISO). Admins only.",
    "rls": {
     "write": {
      "$or": [
       {
        "user_condition": {
         "data.crm_role": "owner"
        }
       },
       {
        "user_condition": {
         "data.crm_role": "admin"
        }
       }
      ]
     }
    }
   }
  },
  "required": [
   "legacy_id",
   "employeeId",
   "rateCents",
   "effectiveFrom"
  ],
  "rls": {
   "read": {
    "$or": [
     {
      "user_condition": {
       "data.crm_role": "owner"
      }
     },
     {
      "user_condition": {
       "data.crm_role": "admin"
      }
     }
    ]
   },
   "create": {
    "$or": [
     {
      "user_condition": {
       "data.crm_role": "owner"
      }
     },
     {
      "user_condition": {
       "data.crm_role": "admin"
      }
     }
    ]
   },
   "update": {
    "user_condition": {
     "data.crm_role": "owner"
    }
   },
   "delete": {
    "user_condition": {
     "data.crm_role": "owner"
    }
   }
  }
 },
